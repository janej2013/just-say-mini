<!--pages/dialog-practice/dialog-practice.wxml-->
<view class="container">
  
  <!-- 顶部区域：进度条 + 标题 + 关闭按钮 -->
  <view class="top-section">
    <view class="header-row">
        <!-- 进度条 (Segmented) -->
        <view class="progress-segments">
            <view class="segment {{currentTaskIdx >= 0 ? 'active' : ''}}"></view>
            <view class="segment {{currentTaskIdx >= 1 ? 'active' : ''}}"></view>
            <view class="segment {{currentTaskIdx >= 2 ? 'active' : ''}}"></view>
        </view>
        <!-- 关闭按钮 -->
        <view class="close-btn-wrapper" bindtap="onClose">
            <text class="close-icon">✕</text>
        </view>
    </view>
    
    <!-- 当前任务说明 -->
    <view class="current-task-title">{{currentTaskData.zh}}</view>
  </view>

  <!-- 对话内容区域 -->
  <view class="chat-container">
    <view class="chat-bubbles">
      <block wx:for="{{dialogList}}" wx:key="id">
        
        <!-- NPC Row -->
        <view wx:if="{{item.type == 'npc'}}" class="dialog-row npc-row">
          <!-- Avatar -->
          <view class="avatar npc-avatar">
            <text>Fox</text>
          </view>
          
          <view class="npc-content-col">
             <!-- Audio Player & Toggle Row -->
             <view class="npc-audio-row">
                <view class="npc-audio-player">
                    <view class="audio-control-btn" bindtap="onPlayNpcAudio" data-id="{{item.id}}">
                        <text wx:if="{{!audioPlaying || currentPlayingDialogId != item.id}}">▶</text>
                        <text wx:else>❚❚</text>
                    </view>
                    <view class="audio-wave">
                        <view class="wave-bar {{audioPlaying && currentPlayingDialogId == item.id ? 'active' : ''}}" wx:for="{{[1,2,3,4,5]}}" wx:key="index"></view>
                    </view>
                    <text class="audio-duration">0:04</text>
                </view>
                
                <!-- 'A' Toggle Button -->
                <view class="npc-text-toggle {{item.showText ? 'active' : ''}}" bindtap="toggleNpcText" data-id="{{item.id}}">
                    <text>A</text>
                </view>
             </view>

             <!-- Text Bubble (Hidden by default) -->
             <view wx:if="{{item.showText}}" class="npc-text-bubble">
                <text>{{item.content}}</text>
             </view>
          </view>
        </view>
        
        <!-- User Row -->
        <view wx:if="{{item.type == 'user'}}" class="dialog-row user-row">
          <view class="user-content-col">
            <!-- Text Bubble -->
            <view class="user-bubble">
              <text>{{item.content}}</text>
            </view>
            
            <!-- Feedback Badge -->
            <view wx:if="{{item.feedbackResult}}" class="feedback-badge {{item.feedbackResult.type}}" bindtap="onShowExamples" data-result="{{item.feedbackResult}}">
              <view class="check-icon" wx:if="{{item.feedbackResult.type == 'perfect'}}">✓</view>
              <text>{{item.feedbackResult.type == 'perfect' ? 'Perfect' : 'Tips'}}</text>
            </view>
          </view>

          <!-- Avatar -->
          <view class="avatar user-avatar">
            <text>👤</text>
          </view>
        </view>

      </block>
    </view>
  </view>

  <!-- 底部操作栏 -->
  <view class="bottom-bar">
    <!-- Suggestion Chips -->
    <view class="suggestion-chips-wrapper" wx:if="{{keywordsHint.length > 0 && !allTasksCompleted}}">
        <view class="chip-item" wx:for="{{keywordsHint}}" wx:key="index">
            <text>{{item}}</text>
        </view>
    </view>

    <view class="controls-row">
        <!-- Microphone Button -->
        <view class="mic-wrapper">
            <button class="microphone-btn {{allTasksCompleted ? 'completed' : ''}} {{isRecording ? 'recording' : ''}}" 
                    bindtouchstart="{{allTasksCompleted ? '' : 'onRecordStart'}}" 
                    bindtouchend="{{allTasksCompleted ? '' : 'onRecordEnd'}}" 
                    bindtouchcancel="{{allTasksCompleted ? '' : 'onRecordEnd'}}"
                    bindtap="{{allTasksCompleted ? 'onCompleteClick' : ''}}">
                <view wx:if="{{allTasksCompleted}}" class="btn-icon icon-check"></view>
                <view wx:else class="btn-icon icon-mic"></view>
            </button>
        </view>
    </view>
  </view>
</view>