/* pages/dialog-practice/dialog-practice.wxss */
page {
  background: linear-gradient(180deg, #f5f7fa 0%, #e8ecf1 100%);
  height: 100vh;
  display: flex;
  flex-direction: column;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;
}

.container {
  height: 100vh;
  background: linear-gradient(180deg, #f5f7fa 0%, #e8ecf1 100%);
  display: flex;
  flex-direction: column;
  position: relative;
}

/* 关闭按钮（页面右上角） */
.close-btn {
  position: fixed;
  top: 25rpx;
  right: 25rpx;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: transparent;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 40rpx;
  color: #9e9e9e;
  border: none;
  padding: 0;
  z-index: 100;
}

.close-btn::after {
  border: none;
}

/* 顶部区域：进度条 + 当前任务说明 */
.top-section {
  padding: 50rpx 40rpx 35rpx;
  background: rgba(255, 255, 255, 0.5);
  backdrop-filter: blur(10rpx);
}

/* 三个任务进度点 */
.task-progress-dots {
  display: flex;
  gap: 16rpx;
  margin-bottom: 28rpx;
  justify-content: space-between;
  width: 100%;
}

.progress-dot {
  flex: 1;
  height: 12rpx;
  background: #e0e0e0;
  border-radius: 6rpx;
  transition: background 0.3s ease;
}

.progress-dot.completed {
  background: linear-gradient(90deg, #00d856, #00d856);
}

/* 当前任务标题 */
.current-task-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #2c2c2c;
  line-height: 1.3;
}

/* 对话内容区域 */
.chat-container {
  flex: 1;
  padding: 20rpx 30rpx 30rpx;
  overflow-y: auto;
  background: transparent;
}

.chat-bubbles {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

/* 对话行容器 */
.dialog-row {
  display: flex;
  margin-bottom: 20rpx;
}

/* NPC气泡行（靠左） */
.npc-row {
  justify-content: flex-start;
}

/* 用户气泡行（靠右） */
.user-row {
  justify-content: flex-end;
  gap: 15rpx;
}

/* NPC语音播放器气泡 */
.npc-audio-player {
  display: flex;
  flex-direction: column;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx 32rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
  max-width: 72%;
}

.npc-audio-player > view:first-child {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.audio-controls {
  display: flex;
  align-items: center;
  flex: 1;
}

.audio-icon {
  width: 68rpx;
  height: 68rpx;
  margin-right: 24rpx;
  background: #000000;
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  color: white;
  font-size: 26rpx;
  flex-shrink: 0;
}

.audio-wave {
  display: flex;
  align-items: flex-end;
  height: 44rpx;
  flex: 1;
  gap: 5rpx;
}

.wave-bar {
  flex: 1;
  width: 6rpx;
  background: #d5d5d5;
  border-radius: 3rpx;
  height: 22rpx;
  opacity: 0.7;
  transition: all 0.3s ease;
}

.wave-bar.active {
  background: #ddd;
  animation: wave 1.2s infinite ease-in-out;
}

.wave-bar.active:nth-child(2n) {
  animation-delay: 0.2s;
}

.wave-bar.active:nth-child(3n) {
  animation-delay: 0.4s;
}

@keyframes wave {
  0%, 100% { 
    height: 20rpx; 
    opacity: 0.6;
  }
  50% { 
    height: 40rpx; 
    opacity: 1;
  }
}

.npc-text-toggle {
  flex-shrink: 0;
  margin-left: 20rpx;
  white-space: nowrap;
}

.role-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #666;
  background: #f5f5f5;
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  border: 1rpx solid #e0e0e0;
  flex-shrink: 0;
}

/* NPC文本内容区域 */
.npc-text-content {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #eee;
  font-size: 28rpx;
  line-height: 1.6;
  color: #333;
  animation: slideDown 0.3s ease-out;
}

@keyframes slideDown {
  from {
    opacity: 0;
    max-height: 0;
    transform: translateY(-10rpx);
  }
  to {
    opacity: 1;
    max-height: 500rpx;
    transform: translateY(0);
  }
}





/* 关键词提示容器 */
.keywords-hint-container {
  display: flex;
  flex-wrap: wrap;
  gap: 15rpx;
  justify-content: center;
  margin: 20rpx 0;
  padding: 0 20rpx;
}

/* 单个关键词样式 */
.keyword-item {
  background: linear-gradient(135deg, #e3f2fd, #bbdefb);
  border-radius: 30rpx;
  padding: 12rpx 24rpx;
  border: 2rpx solid #bbdefb;
  box-shadow: 0 4rpx 8rpx rgba(0, 0, 0, 0.05);
}

.keyword-text {
  font-size: 26rpx;
  color: #1565c0;
  font-weight: 500;
}

/* 对话气泡 */
.chat-bubble {
  padding: 25rpx 30rpx;
  border-radius: 30rpx;
  font-size: 28rpx;
  line-height: 1.5;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}

.user-bubble {
  background: linear-gradient(135deg, #00d856, #00e676);
  color: #ffffff;
  border-radius: 24rpx 24rpx 4rpx 24rpx;
  max-width: 70%;
  font-size: 30rpx;
  animation: slideInRight 0.3s ease-out;
}

/* 用户气泡包装器（包含气泡和反馈按钮） */
.user-bubble-wrapper {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  max-width: 75%;
}

/* 用户头像 */
.user-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #ffffff;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 34rpx;
  flex-shrink: 0;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.08);
  border: 2rpx solid #f0f0f0;
}

/* 反馈按钮 */
.feedback-button {
  margin-top: 12rpx;
  padding: 10rpx 24rpx;
  border-radius: 18rpx;
  font-size: 24rpx;
  font-weight: 500;
  box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.08);
  transition: all 0.3s ease;
  animation: fadeIn 0.5s ease-out;
  align-self: flex-end;
}

.feedback-button.perfect {
  background: #ffffff;
  color: #00d856;
  border: 1rpx solid rgba(0, 216, 86, 0.3);
}

.feedback-button.tips {
  background: #ffffff;
  color: #ff9800;
  border: 1rpx solid rgba(255, 152, 0, 0.3);
}

.feedback-button:active {
  transform: scale(0.95);
  box-shadow: 0 1rpx 3rpx rgba(0, 0, 0, 0.15);
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(-10rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes slideInRight {
  from {
    opacity: 0;
    transform: translateX(20rpx);
  }
  to {
    opacity: 1;
    transform: translateX(0);
  }
}



/* 反馈标签 */
.feedback-badge {
  background: linear-gradient(135deg, #a8d8b9, #80c994);
  color: white;
  padding: 12rpx 25rpx;
  border-radius: 30rpx;
  align-self: flex-end;
  margin-bottom: 25rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 4rpx 8rpx rgba(0, 0, 0, 0.1);
}

.feedback-text {
  font-size: 26rpx;
  font-weight: bold;
}

/* 分页指示器 */
.pagination {
  display: flex;
  justify-content: center;
  align-items: center;
  margin: 20rpx 0 30rpx;
  padding: 0 30rpx;
}

.pagination-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background-color: #d0c0b0;
  margin: 0 12rpx;
  transition: all 0.3s ease;
}

.pagination-dot.active {
  background: linear-gradient(135deg, #ff9a8b, #ff6a72);
  width: 28rpx;
  height: 14rpx;
  border-radius: 7rpx;
}

/* 底部操作栏 */
.bottom-bar {
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding: 35rpx 40rpx 40rpx;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(10rpx);
}

.input-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
}

/* 关键词提示容器 */
.keywords-hint-container {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  justify-content: center;
  margin-bottom: 20rpx;
  max-width: 100%;
}

/* 单个关键词样式 */
.keyword-item {
  background: #f8f8f8;
  border-radius: 24rpx;
  padding: 10rpx 20rpx;
  border: 1rpx solid #ebebeb;
}

.keyword-text {
  font-size: 26rpx;
  color: #757575;
  white-space: nowrap;
}

.microphone-btn {
  width: 100%;
  max-width: 680rpx;
  height: 100rpx;
  border-radius: 50rpx;
  background: linear-gradient(135deg, #00d856, #00e676);
  display: flex;
  justify-content: center;
  align-items: center;
  color: white;
  font-size: 52rpx;
  border: none;
  padding: 0;
  box-shadow: 0 6rpx 16rpx rgba(0, 216, 86, 0.3);
  transition: all 0.3s ease;
  position: relative;
}

.microphone-btn::before {
  content: '';
  position: absolute;
  width: 100%;
  height: 100%;
  border-radius: 50rpx;
  background: radial-gradient(circle at 35% 35%, rgba(255, 255, 255, 0.2), transparent 65%);
  pointer-events: none;
}

.microphone-btn text {
  font-size: 48rpx;
  line-height: 1;
  position: relative;
  z-index: 1;
}

.microphone-btn.recording {
  background: linear-gradient(135deg, #ff5252, #ff7979);
  box-shadow: 0 6rpx 16rpx rgba(255, 82, 82, 0.35);
  animation: pulse-recording 1.5s ease-in-out infinite;
}

.microphone-btn.completed {
  background: linear-gradient(135deg, #4caf50, #66bb6a);
  box-shadow: 0 6rpx 16rpx rgba(76, 175, 80, 0.35);
}

.microphone-btn.completed text {
  font-size: 56rpx;
  font-weight: bold;
}

@keyframes pulse-recording {
  0%, 100% {
    transform: scale(1);
  }
  50% {
    transform: scale(1.05);
  }
}

.microphone-btn::after {
  border: none;
}

.microphone-btn:active {
  transform: scale(0.95);
}