/* Header */
.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16px;
}

.back-btn {
  width: 40px;
  height: 40px;
  background-color: rgba(255, 255, 255, 0.5);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  backdrop-filter: blur(4px);
}

.icon-chevron-left {
  font-size: 24px;
  font-weight: bold;
}

.header-title {
  display: flex;
  align-items: center;
  gap: 8px;
  background-color: rgba(255, 255, 255, 0.5);
  padding: 8px 16px;
  border-radius: 9999px;
  backdrop-filter: blur(4px);
}

.icon {
  font-size: 20px;
}

.title-text {
  font-weight: 600;
  font-size: 16px;
}

.placeholder {
  width: 40px;
}

/* Main Content */
.main-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24px;
  position: relative;
}

.title-section {
  text-align: center;
  margin-bottom: 48px;
}

.main-title {
  display: block;
  font-size: 30px;
  font-weight: bold;
  margin-bottom: 8px;
}

.subtitle {
  font-size: 18px;
  opacity: 0.8;
}

/* Cards */
.cards-container {
  position: relative;
  width: 100%;
  height: 320px; /* Adjust based on card height */
  display: flex;
  justify-content: center;
  align-items: center;
}

.card {
  position: absolute;
  width: 260px;
  height: 360px;
  transition: all 0.8s cubic-bezier(0.4, 0, 0.2, 1); /* Slower transition for stacking */
  perspective: 1000px;
  /* Default state: spread out */
  /* Modified to lower side cards (translateY) and stack effect */
  /* Using squared difference to simulate abs() for compatibility: (index-1)^2 is 1 for side cards, 0 for middle */
  /* Reduced translateX from 110% to 80% for closer static distance */
  transform: translateX(calc((var(--index) - 1) * 80%)) translateY(calc((var(--index) - 1) * (var(--index) - 1) * 20px)) rotate(calc((var(--index) - 1) * 5deg));
  z-index: 10;
}

/* Shuffling State */
.card.shuffling {
  transform: translateX(0) rotate(0) scale(1);
  animation: shuffle 0.5s ease-in-out infinite alternate; /* Slower shuffle */
  animation-delay: calc(var(--index) * 0.1s);
}

@keyframes shuffle {
  0% { transform: translateX(0) translateY(0) rotate(0); }
  100% { transform: translateX(0) translateY(-10px) rotate(2deg); }
}

/* Selected State */
.card.selected {
  transform: translateX(0) rotate(0) scale(1.1);
  z-index: 100; /* Increased z-index to ensure it's above actions */
}

/* Hidden State */
.card.hidden-card {
  opacity: 0;
  pointer-events: none;
  transform: translateX(calc((var(--index) - 1) * 200%)); /* Move further away */
}

.card-inner {
  position: relative;
  width: 100%;
  height: 100%;
  text-align: center;
  transition: transform 0.4s; /* Faster flip */
  transform-style: preserve-3d;
  border-radius: 24px;
  box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.1);
}

.card-inner.flipped {
  transform: rotateY(180deg);
}

.card-face {
  position: absolute;
  width: 100%;
  height: 100%;
  backface-visibility: hidden;
  border-radius: 24px;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

/* Card Back */
.card-back {
  background: linear-gradient(to bottom, #abf1fa, #fce8a7);
  color: white;
  align-items: center;
  justify-content: center;
  border: 4px solid white;
}

.pattern {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  opacity: 0.1;
  background-image: radial-gradient(circle at 2px 2px, white 1px, transparent 0);
  background-size: 20px 20px;
}

.card-control-tower-img {
  /* position: absolute;
  top: 80px;
  right: 40px;
  width: 180px;
  height: 270px; */
  opacity: 0.2;
  transform: scale(0.8);
}

