<view class="container {{levelInfo.color}}">
  <!-- Background Elements -->
  <view class="bg-elements">
    <!-- Ground Hint -->
    <view class="ground-hint"></view>
  </view>
  <!-- Main Content -->
  <view class="main-content">
    
    <!-- Status Text -->
    <view class="status-text-container {{isRevealed ? 'hidden' : ''}}">
        <view class="status-pill">
            <block wx:if="{{isShuffling}}">
                <text class="status-icon spin">🔄</text>
                <text class="status-label">Shuffling...</text>
            </block>
            <block wx:else>
                <text class="status-icon">✨</text>
                <text class="status-label">Picking Card</text>
                <text class="status-icon">✨</text>
            </block>
        </view>
    </view>

    <!-- Cards Container -->
    <view class="cards-container">
      <block wx:for="{{cardOptions}}" wx:key="index">
        <view 
          class="card {{isShuffling ? 'shuffling' : ''}} {{selectedCardIndex === index ? 'selected' : ''}} {{selectedCardIndex !== null && selectedCardIndex !== index ? 'hidden-card' : ''}}"
          style="--index: {{index}};"
          bindtap="onCardTap"
          data-index="{{index}}"
        >
          <view class="card-inner {{isRevealed && selectedCardIndex === index ? 'flipped' : ''}}">
            <!-- Card Back -->
            <view class="card-face card-back">
              <view class="pattern"></view>
              <image class="card-control-tower-img" src="/assets/images/card-back/img-control-tower.svg" mode="aspectFit"></image>
            </view>

            <!-- Card Front -->
            <view class="card-face card-front">
              <view class="card-header">
                <text class="card-header-icon">✨</text>
                <text class="card-header-text">任务卡</text>
                <text class="card-header-icon">✨</text>
              </view>
              <view class="task-list">
                <block wx:for="{{item}}" wx:for-item="task" wx:for-index="taskIndex" wx:key="taskIndex">
                  <view class="task-item">
                    <view class="check-circle">
                      <text class="check-icon">✓</text>
                    </view>
                    <text class="task-text">{{task}}</text>
                  </view>
                </block>
              </view>
              <view class="card-footer">
                <!-- Button removed to match design -->
              </view>
            </view>
          </view>
        </view>
      </block>
    </view>

    <!-- Bottom Controls -->
    <view class="bottom-controls {{isRevealed ? 'visible' : ''}}">
      <!-- Shuffle Button -->
      <button class="control-btn small-btn" bindtap="handleShuffleClick" style="width: fit-content;">
        <text class="btn-icon">🔄</text>
      </button>
      
      <!-- Start Adventure Button -->
      <button class="control-btn primary-btn" bindtap="onStartAdventure" style="width: max-content;">
        <text>Start Adventure</text>
        <text class="btn-icon">▶</text>
      </button>

      <!-- Task List Button -->
      <button class="control-btn small-btn" bindtap="toggleTaskList" style="width: fit-content;">
        <text class="btn-icon">📋</text>
      </button>
    </view>
  </view>

  <!-- Task List Modal -->
  <view class="modal-overlay task-list-overlay" wx:if="{{showTaskList}}" bindtap="closeTaskList">
    <view class="task-list-modal" catchtap="true">
        <!-- Header -->
        <view class="modal-header">
            <view>
                <text class="modal-title">任务卡列表</text>
                <text class="modal-subtitle">进度: {{completedCardIds.length}}/{{allCards.length}}</text>
            </view>
            <view class="close-btn" bindtap="closeTaskList">✕</view>
        </view>

        <!-- Content -->
        <scroll-view scroll-y="true" class="modal-content">
            <block wx:for="{{allCards}}" wx:for-item="card" wx:for-index="idx" wx:key="cardId">
                <view class="group-card {{card.isCompleted ? 'completed' : ''}}">
                    <!-- Card Header -->
                    <view class="group-header">
                        <view class="group-title-row">
                            <view class="group-badge {{card.isCompleted ? 'completed' : ''}}">
                                <text wx:if="{{card.isCompleted}}">✓</text>
                                <text wx:else>{{idx + 1}}</text>
                            </view>
                            <text class="group-title">{{card.title.zh}}</text>
                        </view>
                        <text class="group-progress">{{card.isCompleted ? '3/3' : '0/3'}} Done</text>
                    </view>
                    
                    <!-- Tasks -->
                    <view class="group-tasks">
                        <block wx:for="{{card.tasks}}" wx:for-item="task" wx:for-index="tIdx" wx:key="taskId">
                            <view class="group-task-item">
                                <view class="task-icon-circle {{card.isCompleted ? 'completed' : 'gray'}}">
                                    <text wx:if="{{card.isCompleted}}" class="check-icon">✓</text>
                                </view>
                                <text class="group-task-text {{card.isCompleted ? 'completed-text' : ''}}">{{task.desc.zh}}</text>
                            </view>
                        </block>
                    </view>
                </view>
            </block>
        </scroll-view>
    </view>
  </view>
</view>
