<view class="city-map-container">
  <scroll-view scroll-y class="map-scroll" scroll-top="{{scrollTop}}" scroll-with-animation="true">
    <view class="map-content" style="height: {{mapHeight}}px;">
      <!-- Background Map -->
      <image class="map-bg" src="{{mapSvgUrl}}" mode="widthFix" style="height: {{mapHeight}}px;"></image>
      
      <!-- Interactive Zones (Dynamic) -->
      <block wx:for="{{levels}}" wx:key="id">
        <view 
            class="zone" 
            style="left: {{item.left}}%; top: {{item.top}}%;"
            bindtap="onLevelTap"
            data-id="{{item.id}}"
        >
            <image src="{{item.icon}}" mode="aspectFit" class="zone-image {{!item.isUnlocked ? 'locked' : ''}}"></image>
            <!-- Optional: Add lock overlay if needed -->
        </view>
      </block>
      
      <!-- Bridge Decoration (Optional, keep if needed or remove if it interferes) -->
      <!-- <view class="decoration bridge-decoration">
         <view class="bridge-rect"></view>
      </view> -->

    </view>
  </scroll-view>
  
  <!-- Header / Back Button -->
  <view class="header-overlay" style="padding-top: {{statusBarHeight}}px;">
      <view class="header-bar">
          <view class="header-title-pill">
             <text class="header-title">Adventure Map</text>
          </view>
          <view class="close-btn" bindtap="onBack">
              <text class="close-icon">X</text>
          </view>
      </view>
  </view>
</view>