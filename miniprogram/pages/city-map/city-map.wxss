.city-map-container {
  width: 100vw;
  height: 100vh;
  background-color: #A5D6A7;
  position: relative;
  overflow: hidden;
}

.map-scroll {
  width: 100%;
  height: 100%;
}

.map-content {
  width: 100%;
  /* height set via inline style */
  position: relative;
}

.map-bg {
  width: 100%;
  /* height set via inline style */
  display: block;
  position: absolute;
  top: 0;
  left: 0;
  z-index: 0;
}

.zone {
  position: absolute;
  z-index: 10;
  background: transparent !important;
  /* transform: translate(-50%, -50%);  CSS transform translate works differently with left/top */
  /* We will use specific positioning */
}

.zone-image {
  width: 100%;
  height: 100%;
  display: block;
  background: transparent !important;
}

/* Airport: translate(200, 1350) in 375 width SVG. 
   We need to map this to screen coordinates. 
   Assuming widthFix scales the map to screen width (100vw).
   The SVG viewBox is 0 0 375 1600.
   So 1 unit = 100vw / 375.
*/

/* Using rpx might be easier if we assume 750rpx = 375pt (standard).
   So 1 SVG unit = 2rpx.
*/

.airport-zone {
  width: 400rpx;
  height: 300rpx;
  left: 320rpx;
  top: 2800rpx;
}

.taxi-zone {
  width: 320rpx;
  height: 240rpx;
  left: 40rpx;
  top: 2500rpx;
}

.hotel-zone {
  width: 280rpx;
  height: 360rpx;
  left: 260rpx;
  top: 2020rpx;
}

.bridge-decoration {
  position: absolute;
  left: 300rpx; /* 150 * 2 */
  top: 2100rpx; /* 1050 * 2 */
  width: 120rpx; /* 60 * 2 */
  height: 60rpx; /* 30 * 2 */
  transform: rotate(30deg);
  opacity: 0.3;
  pointer-events: none;
}

.bridge-rect {
  width: 100%;
  height: 100%;
  background-color: #8D6E63;
  border-radius: 8rpx;
}

.header-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  padding: 24rpx;
  pointer-events: none;
  z-index: 100;
}

.header-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  pointer-events: auto;
}

.header-title-pill {
  background-color: rgba(255, 255, 255, 0.8);
  backdrop-filter: blur(10px);
  padding: 16rpx 32rpx;
  border-radius: 999px;
  box-shadow: 0 2rpx 4rpx rgba(0,0,0,0.1);
}

.header-title {
  color: #5D4037;
  font-weight: bold;
  font-size: 28rpx;
}

.close-btn {
  width: 80rpx;
  height: 80rpx;
  background-color: rgba(255, 255, 255, 0.8);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 4rpx rgba(0,0,0,0.1);
}

.close-icon {
  color: #5D4037;
  font-size: 32rpx;
  font-weight: bold;
}
