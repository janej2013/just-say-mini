/* map.wxss */
page {
  height: 100vh;
  overflow: hidden;
}

.container {
  width: 100%;
  height: 100%;
  background-color: #a2d9e7; /* Sea Color */
}

.world-scroll {
  width: 100%;
  height: 100%;
}

.world-map {
  position: relative;
  width: 100%;
  height: 200vh; /* Reduced from 300vh */
  background-image: radial-gradient(#b3e5fc 20%, transparent 20%),
                    radial-gradient(#b3e5fc 20%, transparent 20%);
  background-color: #a2d9e7;
  background-position: 0 0, 50rpx 50rpx;
  background-size: 100rpx 100rpx; /* Dot pattern for sea */
}

.path-layer {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

.path-svg {
  width: 100%;
  height: 100%;
}

/* --- Continents --- */
.continent {
  position: absolute;
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 1;
  background-repeat: no-repeat;
  background-position: center;
  background-size: 100% 100%;
  /* Drop shadow for depth */
  filter: drop-shadow(0 10rpx 5rpx rgba(0,0,0,0.1));
}

.zone-label {
  position: absolute;
  font-size: 28rpx;
  font-weight: bold;
  color: #37474f;
  text-transform: capitalize;
  z-index: 2;
  bottom: 15%;
  text-shadow: 0 2rpx 0 rgba(255,255,255,0.5);
}

/* 8. Office (Top: ~5%) */
.continent-office {
  top: 3%;
  left: 10%;
  width: 80%;
  height: 15%;
