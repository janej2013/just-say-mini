  height: 80rpx;
  background-color: #3949AB;
  border-radius: 4rpx;
  box-shadow: 2rpx 2rpx 0 rgba(0,0,0,0.2);
}
.b1 { left: 35%; height: 90rpx; }
.b2 { right: 35%; }

