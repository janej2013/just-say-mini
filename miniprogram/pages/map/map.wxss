  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath fill='%239CCC65' stroke='white' stroke-width='8' d='M45,-65C58,-55,68,-42,75,-28C82,-14,86,2,82,16C78,30,66,42,53,53C40,64,26,74,10,76C-6,78,-20,72,-33,63C-46,54,-58,42,-65,28C-72,14,-74,-2,-68,-16C-62,-30,-48,-42,-35,-52C-22,-62,-8,-70,8,-72C24,-74,32,-75,45,-65Z' transform='translate(100 100)' /%3E%3C/svg%3E");
