<view class="container">
  <view class="district-map">
    <!-- 1. Airport Terminal -->
    <view class="location-zone airport-zone">
      <view class="building-airport">
        <view class="roof"></view>
        <view class="body">
          <view class="gate">GATE 1</view>
          <view class="windows"></view>
        </view>
        <view class="wing left"></view>
        <view class="wing right"></view>
      </view>
      <view class="npc-penguin"></view>
      <view class="zone-label">动物机场</view>
      
      <view class="level-container">
        <view wx:for="{{levels}}" wx:key="index" class="level-item">
          <view class="level-header {{selectedLevelIndex == index ? 'selected' : ''}}">
            <view class="status-icon" bindtap="toggleLevelExpansion" data-level-index="{{index}}">
              <text>{{expandedLevels[index] ? '−' : '+'}}</text>
            </view>
            <text bindtap="selectLevel" data-level-index="{{index}}">{{item.title.zh}}</text>
          </view>
          
          <!-- 任务列表 -->
          <view class="task-list" wx:if="{{expandedLevels[index]}}">
            <view class="task-item" 
                  wx:for="{{item.tasks}}" 
                  wx:key="taskId">
              <view class="task-bullet">•</view>
              <text>{{item.zh}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>
    
    <!-- Now Start Button -->
    <view class="start-button" bindtap="startAdventure">
      <text>现在开始吧！</text>
    </view>
  </view>
</view>