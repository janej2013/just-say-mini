<view class="container" catchtap="handleBgClick">
  <!-- Background Elements -->
  <view class="bg-elements">
    <!-- Control Tower -->
    <image class="control-tower-img" src="/assets/images/level_task_map/img-control-tower.svg" mode="aspectFit"></image>
    
    <!-- Ground Hint -->
    <view class="ground-hint"></view>
  </view>
  <!-- Map Content -->
  <view class="map-content">
    <!-- SVG Path Background -->
    <image class="map-path-bg" src="/assets/images/level_task_map/bg-map-path.svg" mode="aspectFill"></image>

    <!-- Level Nodes -->
    <block wx:for="{{airportData.levels}}" wx:key="levelId" wx:for-index="index">
      <view 
        class="level-node-wrapper" 
        style="top: {{index === 0 ? 580 : index === 1 ? 340 : 40}}px; left: {{index === 1 ? 240 : 40}}px;"
        catchtap="handleLevelClick"
        data-index="{{index}}"
      >
        <!-- Icon Circle -->
        <view class="cartoon-btn-container {{index === 0 ? 'btn-green' : index === 1 ? 'btn-orange' : 'btn-yellow'}} {{activeLevelIndex === index ? 'selected' : ''}}">
          <image 
            class="node-icon {{index === 0 ? 'plane-rotate' : ''}}" 
            src="{{index === 0 ? '/assets/images/level_task_map/icon-plane-white.svg' : index === 1 ? '/assets/images/level_task_map/icon-map-white.svg' : '/assets/images/level_task_map/icon-luggage-white.svg'}}" 
            mode="aspectFit"
            style="width: 50%; height: 50%;"
          ></image>
          
          <!-- Selected Ring -->
          <view wx:if="{{activeLevelIndex === index}}" class="selected-ring"></view>
        </view>

        <!-- Star Rating -->
        <view class="stars-container">
          <block wx:for="{{starArray}}" wx:key="*this" wx:for-item="star">
            <image 
              class="star-icon" 
              src="{{star <= item.stars ? '/assets/images/level_task_map/icon-star-active.svg' : '/assets/images/level_task_map/icon-star-inactive.svg'}}" 
              mode="aspectFit"
            ></image>
          </block>
        </view>
      </view>

      <!-- Task Bubble -->
      <view 
        wx:if="{{activeLevelIndex === index}}" 
        class="task-bubble"
        style="{{bubbleStyle}}"
        catchtap="handleBubbleClick"
      >
        <view class="bubble-content">
          <view class="bubble-header">
            <text class="bubble-title">{{item.title.zh}}</text>
          </view>

          <!-- Task List -->
          <view class="task-list">
            <block wx:for="{{item.tasks}}" wx:key="taskId" wx:for-item="task">
              <view class="task-item">
                <view class="task-dot {{item.status === 'completed' ? 'dot-completed' : 'dot-active'}}"></view>
                <text class="task-text">{{task.zh}}</text>
              </view>
            </block>
          </view>

          <!-- Start Button -->
          <button 
            class="start-btn {{item.status === 'locked' ? 'btn-locked' : activeLevelIndex === 0 ? 'start-btn-green' : activeLevelIndex === 1 ? 'start-btn-orange' : 'start-btn-yellow'}}" 
            disabled="{{item.status === 'locked'}}"
            catchtap="onStart"
          >
            <text>{{item.status === 'locked' ? 'Locked' : 'Start'}}</text>
            <image wx:if="{{item.status !== 'locked'}}" class="play-icon" src="/assets/images/level_task_map/icon-play-white.svg" mode="aspectFit"></image>
          </button>
        </view>

        <!-- Bubble Arrow -->
        <view class="bubble-arrow {{bubbleArrowClass}}"></view>
        
        <!-- Close Button -->
        <view class="close-btn" catchtap="handleCloseBubble">
          <image class="icon-close" src="/assets/images/level_task_map/icon-close.svg" mode="aspectFit"></image>
        </view>
      </view>

      <!-- Avatar on Active Level -->
      <view 
        wx:if="{{item.status === 'active'}}" 
        class="avatar-wrapper"
        style="top: {{index === 0 ? 535 : index === 1 ? 295 : 55}}px; left: {{index === 1 ? 290 : 90}}px;"
      >
        <view class="avatar-circle">
          <image class="paw-icon" src="/assets/images/level_task_map/icon-paw-custom.svg" mode="aspectFit"></image>
        </view>
      </view>

    </block>
  </view>
</view>
