/* --- Decor --- */
.tree {
  position: absolute;
  width: 20px;
  height: 30px;
  background-color: #388E3C;
  clip-path: polygon(50% 0%, 0% 100%, 100% 100%);
  z-index: 2;
}
.t1 { top: 30%; left: 20%; }
.t2 { top: 40%; right: 10%; }
.t3 { top: 20%; left: 20%; }
.t4 { top: 30%; right: 30%; }

/* Restaurant Building */
.building-restaurant {
  position: absolute;
  top: 25%;
  left: 30%;
  width: 100px;
  height: 80px;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.building-restaurant .roof {
  width: 110%;
  height: 20px;
  background: #546E7A;
  clip-path: polygon(10% 0%, 90% 0%, 100% 100%, 0% 100%);
}
.building-restaurant .body {
  width: 90%;
  height: 60px;
  background: #8D6E63;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  padding: 5px 0;
}
.building-restaurant .sign {
  background: #3F51B5;
  color: white;
  padding: 2px 5px;
  border-radius: 4px;
  font-size: 12px;
  display: flex;
  gap: 5px;
}
.building-restaurant .counter {
  color: #3E2723;
  font-weight: bold;
  font-size: 20px;
  letter-spacing: 5px;
}

/* Company Building */
.building-company {
  position: absolute;
  top: 30%;
  left: 30%;
  display: flex;
  align-items: flex-end;
}
.skyscraper {
  background: #1A237E;
  border: 1px solid #3949AB;
}
.s1 { width: 30px; height: 60px; background: linear-gradient(90deg, #1A237E 50%, #3949AB 50%); border-radius: 10px 0 0 0; }
.s2 { width: 40px; height: 50px; background: linear-gradient(90deg, #304FFE 50%, #536DFE 50%); }

/* School Building */
.building-school {
  position: absolute;
  top: 40%;
  left: 30%;
  width: 80px;
  height: 50px;
  background: #9FA8DA;
  display: flex;
  align-items: flex-end;
}
.building-school .wing {
  width: 50%;
  height: 100%;
  border: 1px solid #7986CB;
}
.building-school .left { background: white; width: 40%; }
.building-school .right { background: #9FA8DA; width: 60%; height: 80%; }

/* Labels */
.label-marker {
  position: absolute;
  bottom: 10%;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.pin {
  width: 20px;
  height: 30px;
  background: #F44336;
  border-radius: 50% 50% 50% 0;
  transform: rotate(-45deg);
  margin-bottom: 5px;
}
.pin::after {
  content: '';
  position: absolute;
  top: 5px;
  left: 5px;
  width: 10px;
  height: 10px;
  background: white;
  border-radius: 50%;
}
.dot {
  width: 8px;
  height: 8px;
  background: black;
  border-radius: 50%;
  margin-bottom: 5px;
}
.label-marker text {
  font-weight: bold;
  font-size: 14px;
  color: black;
}

.lock-icon {
  font-size: 40px;
  opacity: 0.5;
}
